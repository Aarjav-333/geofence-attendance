# ─────────────────────────────────────────────────────────────
# Geofence Attendance — environment configuration
# Copy to `.env.local` for local development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── Geofence ────────────────────────────────────────────────
# Authorized workplace (decimal degrees, WGS84): Principal's office, College of Engineering
# Trivandrum (OpenStreetMap node 3695678553, https://www.openstreetmap.org/node/3695678553)
TARGET_LATITUDE=8.5458387
TARGET_LONGITUDE=76.9062601
# Radius of the allowed area in meters (distance <= radius → WITHIN_RANGE)
GEOFENCE_RADIUS_METERS=100
# GPS fixes with a reported accuracy worse than this are flagged as "low accuracy"
# (the status is still decided by the computed distance, not by accuracy)
LOW_ACCURACY_THRESHOLD_METERS=50
# GPS fixes with a reported accuracy worse than this are rejected as insufficient
MAX_ACCURACY_METERS=150

# Public base URL encoded in the workplace QR code (…/attendance).
# Optional: on Vercel the production domain is used automatically.
# APP_URL=https://geofence-attendance-eta.vercel.app

# Timezone for "Today" counts and timestamps on the admin dashboard
DISPLAY_TIMEZONE=Asia/Kolkata

# ── Database (PostgreSQL 13+) ───────────────────────────────
# Local (docker compose up -d):
DATABASE_URL=postgres://geofence:geofence@localhost:5433/geofence
# Production example (Neon via Vercel Marketplace sets this automatically):
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
# TLS: local hosts use none, remote hosts use verify-full. Override only if needed:
# DATABASE_SSL=disable|require|verify-full

# ── Admin authentication ────────────────────────────────────
ADMIN_USERNAME=admin
# Generate with:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Optional: more administrators with exactly the same privileges (role "admin").
# Format: username=<scrypt hash>, several separated by ";". Hashes only — never plaintext.
#   ADDITIONAL_ADMINS=master=scrypt:16384:8:1:...;ops=scrypt:16384:8:1:...
ADDITIONAL_ADMINS=
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
