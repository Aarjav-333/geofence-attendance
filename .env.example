# ─────────────────────────────────────────────────────────────
# Geofence Attendance — environment configuration
# Copy to `.env.local` for local development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# ── Geofence ────────────────────────────────────────────────
# Designated location (decimal degrees, WGS84)
TARGET_LATITUDE=8.54612616725849
TARGET_LONGITUDE=76.90465781805145
# Radius of the allowed area in meters (distance <= radius → WITHIN_RANGE)
GEOFENCE_RADIUS_METERS=100
# GPS fixes with a reported accuracy worse than this are flagged as "low accuracy"
# (the status is still decided by the computed distance, not by accuracy)
LOW_ACCURACY_THRESHOLD_METERS=50

# Optional: comma-separated suggestions shown in the Department field
DEPARTMENTS=Computer Science,Electronics,Mechanical,Civil,Electrical,Administration

# Timezone for "Today" counts and timestamps on the admin dashboard
DISPLAY_TIMEZONE=Asia/Kolkata

# ── Database (PostgreSQL 13+) ───────────────────────────────
# Local (docker compose up -d):
DATABASE_URL=postgres://geofence:geofence@localhost:5433/geofence
# Production example (Neon via Vercel Marketplace sets this automatically):
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ── Admin authentication ────────────────────────────────────
ADMIN_USERNAME=admin
# Generate with:  npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
